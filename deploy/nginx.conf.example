# Example Nginx server block for deploying Rizal Heritage on a single
# domain, with the frontend at `/` and the API at `/api`.
#
# Install: copy this to /etc/nginx/sites-available/rizalheritage.conf,
# edit `yourdomain.com`, then:
#   sudo ln -s /etc/nginx/sites-available/rizalheritage.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
#
# With this setup, set NEXT_PUBLIC_API_URL=https://yourdomain.com/api
# in your root .env before `docker compose build frontend` — the browser
# then calls the API on the same origin as the site, so CORS_ORIGIN can
# simply be https://yourdomain.com too.

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Backend API
    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend (Next.js)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
