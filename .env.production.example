# Production .env template for shared hosting (cPanel-style, PHP-only —
# no Node process needs to run on the server; the Vite build is done
# locally/CI and its output uploaded as static files). Copy this to
# `.env` on the server and fill in the real values. See DEPLOYMENT.md
# for the full step-by-step.

APP_NAME="Rizal Heritage"
APP_ENV=production
APP_KEY=                        # generate locally with `php artisan key:generate --show`, paste the output here
APP_DEBUG=false
APP_URL=https://your-domain.com # must match the real public URL exactly — Storage::url() and asset() build off this

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Most shared hosts give you a MySQL database + user through cPanel's
# "MySQL Databases" tool, usually prefixed with your cPanel username
# (e.g. cpaneluser_rizal, cpaneluser_rizaluser).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# "database" avoids needing a writable file-based session/cache path
# outside storage/, and needs no extra service (Redis/Memcached) that a
# basic shared host may not offer.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true       # site is served over https
CACHE_STORE=database
QUEUE_CONNECTION=database

# Public disk — where product images/videos uploaded via the admin panel
# are stored (storage/app/public, served through the storage:link at
# public/storage). See DEPLOYMENT.md for the no-SSH fallback if your
# host won't let you create that symlink.
FILESYSTEM_DISK=public

MAIL_MAILER=log                 # switch to smtp + your host's mail credentials once you have them

# Public WhatsApp number the storefront's "Order via WhatsApp" links use
# (country code + number, no + or spaces, e.g. 6281234567890).
VITE_WHATSAPP_NUMBER=6281234567890

# Optional — leave blank to keep the Insight dashboard's GA4 section
# showing "not configured". From a GA4 service account's downloaded JSON
# key: only client_email and private_key are needed, not the whole file.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
